{
  "expo": {
    "name": "DeepTutor",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/color-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/color-logo.png",
      "bundleIdentifier": "com.deeptutor.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/brand/color-logo.png",
        "monochromeImage": "./assets/brand/black-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deeptutor.mobile"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/brand/favicon-32x32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/brand/color-logo.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#1a1918",
            "image": "./assets/brand/color-logo.png"
          }
        }
      ],
      "./plugins/withAndroidHttp.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ba46f0b6-da91-4683-9c39-a72d95ba10cb"
      }
    }
  }
}
