  },
  "paths": {
    "/api/auth/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Existing mobile contract fixture",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "enabled": false,
                  "authenticated": false
                }
              }
            }
          },
          "503": {
            "description": "Existing mobile contract fixture",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "detail": "Workspace service unavailable"
                }
              }
            }
          }
        }
      }
    },
